{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "dontAsk",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(python -m proveit check *)",
      "Bash(python -m proveit evidence *)",
      "Bash(python -m proveit show *)",
      "Bash(python -m proveit list *)",
      "Bash(python -m proveit tally *)",
      "Bash(python -m proveit concur *)",
      "Bash(python -m proveit dispute *)",
      "Bash(python3 -m proveit check *)",
      "Bash(python3 -m proveit evidence *)",
      "Bash(python3 -m proveit show *)",
      "Bash(python3 -m proveit list *)",
      "Bash(python3 -m proveit tally *)",
      "Bash(python3 -m proveit concur *)",
      "Bash(python3 -m proveit dispute *)"
    ],
    "deny": [
      "Bash(python -m proveit override *)",
      "Bash(python -m proveit cost *)",
      "Bash(python -m proveit submit *)",
      "Bash(python -m proveit build *)",
      "Bash(python -c *)",
      "Bash(python work/*)",
      "Bash(python -m pip *)",
      "Bash(python3 -m proveit override *)",
      "Bash(python3 -m proveit cost *)",
      "Bash(python3 -m proveit submit *)",
      "Bash(python3 -m proveit build *)",
      "Bash(python3 -c *)",
      "Bash(python3 work/*)",
      "Bash(python3 -m pip *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(nc *)",
      "Bash(ncat *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(sftp *)",
      "Bash(ftp *)",
      "Bash(telnet *)",
      "Bash(docker *)",
      "Bash(rm *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(chmod *)",
      "Bash(git *)",
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(sh *)",
      "Bash(bash *)",
      "Bash(zsh *)",
      "Bash(powershell *)",
      "Bash(pwsh *)",
      "Bash(env *)",
      "Bash(printenv *)",
      "Bash(set *)",
      "Bash(export *)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Read(./work/*/private/**)",
      "Read(./.proveit/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/**)",
      "Edit",
      "Write",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Read(//**/work/*/private/**)",
      "Read(../../work/*/private/**)"
    ]
  },
  "env": {
    "PROVEIT_ACTOR": "agent",
    "PYTHONPATH": "../.."
  }
}
