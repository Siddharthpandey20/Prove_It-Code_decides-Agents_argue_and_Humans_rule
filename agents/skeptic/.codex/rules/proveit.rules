# Commands the Skeptic must never run. Only `forbidden` decisions are used
# here: an `allow` decision would run a command outside Codex's sandbox.
# Format: https://learn.chatgpt.com/docs/agent-configuration/rules
#
# Rules match the command's leading words exactly, so a rule on a path
# (`cat work`) cannot protect files: `cat ../../work/...` would not match it.
# Codex's workspace-write sandbox limits writes, not reads. So instead of
# guarding paths, this file forbids the tools that read files: the Skeptic
# needs only `python -m proveit evidence|show|list|tally|concur|dispute`.
# Check this file with:
#   codex execpolicy check --rules agents/skeptic/.codex/rules/proveit.rules <command...>

prefix_rule(
    pattern = [["python", "python3"], "-m", "proveit", "check"],
    decision = "forbidden",
    justification = "The Skeptic examines evidence (proveit evidence); it does not produce it.",
    match = ["python -m proveit check R-001", "python3 -m proveit check R-001"],
    not_match = ["python -m proveit evidence R-001", "python3 -m proveit concur R-001 --by skeptic"],
)

prefix_rule(
    pattern = [["python", "python3"], "-m", "proveit", ["override", "cost", "submit", "build"]],
    decision = "forbidden",
    justification = "Only maintainers override disputes, record cost, submit reports or build images.",
    match = ["python -m proveit override R-001 --by x", "python3 -m proveit cost R-001 --usd 1 --source x"],
)

prefix_rule(
    pattern = [["python", "python3"], ["-c", "-", "-i"]],
    decision = "forbidden",
    justification = "No ad hoc code: only the proveit commands.",
    match = ["python -c 'print(1)'", "python3 -c 'print(1)'", "python -"],
    not_match = ["python -m proveit evidence R-001"],
)

prefix_rule(
    pattern = [["python", "python3"], "-m", ["pip", "http.server", "json.tool", "base64", "zipfile", "tarfile"]],
    decision = "forbidden",
    justification = "Only the proveit module, never other modules that read or serve files.",
    match = ["python3 -m json.tool ../../work/R-001/private/contact.json", "python -m pip install x"],
)

prefix_rule(
    pattern = [["cat", "head", "tail", "less", "more", "sed", "awk", "grep", "egrep", "fgrep", "rg",
                "strings", "xxd", "od", "hexdump", "base64", "nl", "tac", "cut", "sort", "uniq", "diff",
                "cmp", "find", "file", "open", "vi", "vim", "nano", "jq", "perl", "ruby", "node"]],
    decision = "forbidden",
    justification = "The Skeptic reads tickets only through `python -m proveit evidence`; reporter material in work/*/private/ is off limits.",
    match = ["cat ../../work/R-001/private/report.md", "head work/R-001/private/payload.yaml",
             "grep -r token ../../work", "sed -n 1p ../../work/R-001/private/report.md"],
)

prefix_rule(
    pattern = [["curl", "wget", "nc", "ncat", "ssh", "scp", "sftp", "ftp", "telnet"]],
    decision = "forbidden",
    justification = "No network from the triage agents.",
    match = ["curl https://example.com", "wget https://example.com"],
)

prefix_rule(
    pattern = [["bash", "sh", "zsh", "env", "printenv", "sudo", "su"]],
    decision = "forbidden",
    justification = "No nested shells and no environment dumps.",
    match = ["bash -c 'cat x'", "sh -c id", "printenv"],
)

prefix_rule(
    pattern = ["docker"],
    decision = "forbidden",
    justification = "The Skeptic never runs containers.",
    match = ["docker ps"],
)

prefix_rule(
    pattern = [["rm", "mv", "cp", "chmod", "git"]],
    decision = "forbidden",
    justification = "The Skeptic never changes files.",
    match = ["rm -rf work", "git status"],
)
